<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- 运行时 uploads 写入不触发 dotnet watch 热重载（.NET 10 SDK 亦生效） -->
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot/uploads/**;wwwroot/upload/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Takt.Application\Takt.Application.csproj" />
    <ProjectReference Include="..\Takt.Infrastructure\Takt.Infrastructure.csproj" />
    <ProjectReference Include="..\Takt.Shared\Takt.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 运行时上传目录变更不触发 dotnet watch 热重载/重启 -->
    <Content Update="wwwroot\uploads\**\*" Watch="false" />
    <Content Update="wwwroot\upload\**\*" Watch="false" />
    <Watch Remove="wwwroot\uploads\**\*" />
    <Watch Remove="wwwroot\upload\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="9.0.19" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.19" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.6.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.6.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.18" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SqlSugarCore" Version="5.1.4.216" />
  </ItemGroup>

</Project>
