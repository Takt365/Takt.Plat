{
  "_Setup": "复制为 appsettings.json；替换全部 <...>；敏感项勿提交 Git",
  "_Setup2": "环境覆盖：appsettings.Development.Example.json / appsettings.Production.Example.json",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "TaktLogging": {
    "AppName": "<应用显示名>",
    "AppVersion": "<版本号>",
    "Environment": "Development",
    "MinLevel": "Info",
    "EnableRemoteReport": false,
    "RemoteReportUrl": "",
    "BatchSize": 20,
    "FlushIntervalMs": 10000,
    "ConsoleOutputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}",
    "FileOutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/takt-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Localization": {
    "DefaultCulture": "en-US",
    "ResourcesPath": "Resources",
    "UseDatabaseLocalization": true
  },
  "ConnectionStrings": {
    "_Comment": "OpenIddict 认证库；各租户业务库键名 Tenant_{租户编码} 在 Development/Production 覆盖文件中按 TenantCodes 逐项添加",
    "OpenIddict": "Server=<SqlServerHost>;Database=<OpenIddictDatabase>;User Id=<SqlUser>;Password=<SqlPassword>;TrustServerCertificate=true;",
    "ConnectionStringTemplate": "Server=<SqlServerHost>;Database=<TenantDatabase>;User Id=<SqlUser>;Password=<SqlPassword>;TrustServerCertificate=true;"
  },
  "Database": {
    "DbType": 1,
    "_Comment_TenantCodes": "租户编码列表（三位），与 ConnectionStrings 中 Tenant_* 键一致",
    "TenantCodes": [ "<TenantCode>" ],
    "_Comment_CompanyCodes": "各租户下公司主档编码，按业务填写",
    "CompanyCodes": [ "<CompanyCode>" ],
    "_Comment_PlantCodes": "工厂编码，按业务填写",
    "PlantCodes": [ "<PlantCode>" ],
    "ConnectionStringTemplate": "Server=<SqlServerHost>;Database=<TenantDatabase>;User Id=<SqlUser>;Password=<SqlPassword>;TrustServerCertificate=true;"
  },
  "Init": {
    "InitDb": false,
    "SeedData": false
  },
  "Excel": {
    "Author": "<导出作者>",
    "Title": "<导出标题>",
    "Subject": "<导出主题>",
    "Category": "Export",
    "Keywords": "",
    "Comments": "",
    "Status": "Final",
    "Application": "<应用名>",
    "Company": "<公司名>",
    "Manager": "<负责人>"
  },
  "Authentication": {
    "AccessTokenLifetimeHours": 2,
    "RefreshTokenLifetimeDays": 7,
    "RefreshTokenReuseLeewayMinutes": 5
  },
  "TenantContext": {
    "TenantHeaderName": "X-Tenant-Code",
    "CompanyHeaderName": "X-Company-Code"
  },
  "Security": {
    "RateLimit": {
      "Enabled": true,
      "MaxRequests": 1000,
      "TimeWindowSeconds": 60
    },
    "CsrfProtection": { "Enabled": true },
    "XssProtection": {
      "Enabled": true,
      "AllowedFileExtensions": [ "pdf", "docx", "xlsx", "png", "jpg", "zip" ]
    }
  },
  "PasswordPolicy": {
    "DefaultPassword": "<种子默认密码>",
    "MinLength": 8,
    "RequireDigit": true,
    "RequireLowercase": true,
    "RequireUppercase": true,
    "RequireSpecialCharacter": true,
    "Transport": {
      "Enabled": true,
      "_Comment": "生成 RSA 密钥对后填入，勿提交私钥到 Git",
      "PublicKeyPem": "",
      "PrivateKeyPem": ""
    }
  },
  "AccountLock": {
    "Enabled": true,
    "ErrorLimit": 5,
    "LockReason": "连续登录失败{ErrorCount}次，达到错误次数限制（{ErrorLimit}次）"
  },
  "System": {
    "SingleLogin": false,
    "ShowDbLog": false,
    "DemoMode": false,
    "Environment": "Development"
  },
  "PrimaryKeyType": {
    "Identity": { "Enabled": true },
    "Guid": { "Enabled": true },
    "Snowflake": {
      "Enabled": true,
      "WorkId": 0,
      "_Comment": "WorkId 0-63 每台服务器唯一，见 appsettings.Snowflake.example.json"
    }
  },
  "Captcha": {
    "Enabled": true,
    "Type": "Behavior",
    "ExpirationMinutes": 5
  },
  "Cache": {
    "Provider": "Memory",
    "DefaultExpirationMinutes": 30,
    "EnableSlidingExpiration": true,
    "Menu": { "Enabled": true },
    "Memory": {
      "CompactionPercentage": 0.25,
      "ExpirationScanFrequency": 60
    },
    "Redis": {
      "Enabled": false,
      "ConnectionString": "",
      "InstanceName": "<Redis实例前缀>",
      "DefaultDatabase": 0,
      "Password": ""
    }
  },
  "Email": {
    "SmtpHost": "<SmtpHost>",
    "SmtpPort": 587,
    "SmtpUsername": "<SmtpUser>",
    "SmtpPassword": "<SmtpPassword>",
    "FromEmail": "<FromEmail>",
    "FromName": "<FromName>",
    "EnableSsl": true,
    "SkipSslCertificateValidation": false,
    "EnableAttachments": true,
    "MaxAttachmentSizeMB": 25,
    "MaxEmailSizeMB": 50
  },
  "AllowedHosts": "*"
}
