{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases（与 vite.config.ts buildResolveAlias 保持一致；TS 6+ 不用 baseUrl，paths 相对本文件） */
    "paths": {
      "@/setting": ["./src/setting.ts"],
      "@/stores/common/setting": ["./src/stores/common/setting.ts"],
      "@/*": ["./src/*"],
      "@api/*": ["./src/api/*"],
      "@bootstrap/*": ["./src/bootstrap/*"],
      "@components/*": ["./src/components/*"],
      "@composables/*": ["./src/composables/*"],
      "@config/*": ["./src/config/*"],
      "@directives/*": ["./src/directives/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@locales/*": ["./src/locales/*"],
      "@router/*": ["./src/router/*"],
      "@stores/*": ["./src/stores/*"],
      "@styles/*": ["./src/styles/*"],
      "@types/*": ["./src/types/*"],
      "@utils/*": ["./src/utils/*"],
      "@views/*": ["./src/views/*"]
    },

    /* Types */
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["src/config/vite-dev-plugin.ts", "src/config/vite-log-file-writer.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
