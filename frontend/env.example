# ========================================
# 前端环境变量模板（无真实地址/端口，复制后自行填写）
#   copy env.example .env
#   copy env.development.example .env.development
#   copy env.production.example .env.production
# 含空格 / # 的值须双引号；占位符 <...> 必须替换
# ========================================

VITE_APP_TITLE="Takt Plat"

# 根地址仅写在 .env.development / .env.production（此处勿写，避免空值覆盖模式文件）
# VITE_APP_ORIGIN=https://<前端主机>:<前端端口>

# 开发用相对路径 + 代理；生产在 .env.production 改为完整 URL
VITE_API_BASE_URL=/api

# 与 VITE_APP_ORIGIN 端口一致
VITE_DEV_SERVER_PORT=<前端端口>

VITE_BUILD_TARGET=es2022
VITE_BUILD_SOURCEMAP=false

# 仅开发：后端 HTTPS 根地址（与 README / 本地 launchSettings 一致后填写）
# VITE_API_PROXY_TARGET=https://<后端主机>:<后端HTTPS端口>
VITE_API_PROXY_CHANGE_ORIGIN=true
VITE_API_PROXY_SECURE=false
VITE_PROXY_PATH_CONNECT=/connect
VITE_PROXY_PATH_HUBS=/hubs

VITE_DEV_SERVER_HTTPS=true
VITE_DEV_SERVER_HOST=

# 须与后端 OpenIddict SpaClientId 一致（公开客户端 ID，非密钥）
VITE_OAUTH_CLIENT_ID=takt-spa
# VITE_OAUTH_REDIRECT_URI=https://<前端主机>:<前端端口>/auth/callback
VITE_AUTH_IDLE_TIMEOUT_MINUTES=30
VITE_AUTH_IDLE_WARNING_MINUTES=5

VITE_OAUTH_SCOPE="openid profile email offline_access"
VITE_OAUTH_AUTHORIZE_PATH=/connect/authorize
VITE_OAUTH_TOKEN_PATH=/connect/token

VITE_SIGNALR_HUB_CONNECT_PATH=/hubs/TaktConnectHub
VITE_SIGNALR_HUB_NOTIFICATION_PATH=/hubs/TaktNotificationHub

VITE_PWA_ENABLED=true
VITE_PWA_DEV_ENABLED=false
VITE_PWA_SHORT_NAME="Takt"
VITE_PWA_THEME_COLOR="#1677ff"
VITE_PWA_BACKGROUND_COLOR="#ffffff"
VITE_PWA_DESCRIPTION="节拍工厂·Takt Plat"
